# Copy to ~/blank-cloud/.env and fill in values, then: docker compose up --build -d

BLANK_CLOUD_PROJECT=./project
BLANK_CLOUD_DATA=./data

# Required for sidebar "Connect GitHub" (no PAT)
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Callback URL must be: ${BLANK_CLOUD_PUBLIC_URL}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
BLANK_CLOUD_PUBLIC_URL=http://192.168.1.100:8787
SESSION_SECRET=change-me-to-a-long-random-string

# Optional LLM bootstrap (or set keys in Web UI → Model)
# LLM_PROVIDER=openai
# LLM_PROVIDER=grok
# OPENAI_API_KEY=
# XAI_API_KEY=   # xAI Grok — https://console.x.ai

# Do not use GITHUB_TOKEN here if you use OAuth — it keeps you "logged in" after sign out
# GITHUB_TOKEN=

# Agent terminal during a task (rm, npm test, git, … inside the project). Set 0 to disable.
# BLANK_CLOUD_AGENT_SHELL=1

# Stream assistant tokens to the UI in real time (default on). Set 0 for batch mode (wait for full reply).
# BLANK_CLOUD_AGENT_STREAM=1
